model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["SalesOrder","SalesTerritory","Sales","Date","Product","Customer"]

annotation PBI_ProTooling = ["DevMode"]

ref table SalesOrder
ref table SalesTerritory
ref table Sales
ref table Date
ref table Product
ref table Customer

ref cultureInfo en-US

